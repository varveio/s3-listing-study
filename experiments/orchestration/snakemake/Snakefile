import os
import sys
from pathlib import Path, PurePosixPath

from snakemake_interface_executor_plugins.settings import ExecMode

# Source archives are extracted at the repository root. The study package is
# deliberately loaded from the deployed source, not from an editable host
# installation that will not exist in Batch.
sys.path.insert(0, "src")
sys.path.insert(0, "experiments/orchestration/snakemake/scripts")

from workflow import (  # noqa: E402
    MARKER_ROOT,
    attempt_for_wildcards,
    canonical_provider_projection,
    deployable_source_paths,
    executor_runtime_image,
    load_campaign,
    load_execution_profile,
    marker_path,
    project_attempt,
    require_sha256,
)


def required_config(name):
    value = config.get(name)
    if not value:
        raise ValueError(f"Snakemake config requires {name}=...")
    return value


MODE = workflow.workflow_settings.exec_mode
if MODE == ExecMode.DEFAULT:
    RUN_DIR = os.environ.get("S3_STUDY_RUN_DIR")
    if not RUN_DIR:
        raise ValueError("S3_STUDY_RUN_DIR is required")
    run_dir_parts = PurePosixPath(RUN_DIR).parts
    if (
        RUN_DIR != PurePosixPath(RUN_DIR).as_posix()
        or len(run_dir_parts) != 3
        or run_dir_parts[:2] != (".snakemake", "runs")
        or run_dir_parts[2] in (".", "..")
        or "\\" in RUN_DIR
    ):
        raise ValueError(
            "S3_STUDY_RUN_DIR must be exactly .snakemake/runs/<single-name> "
            "using canonical repository-relative spelling"
        )
    expected_campaign_path = f"{RUN_DIR}/campaign.json"
    expected_execution_profile_path = f"{RUN_DIR}/execution-profile.json"
    for name, expected in (
        ("campaign_path", expected_campaign_path),
        ("execution_profile_path", expected_execution_profile_path),
    ):
        if required_config(name) != expected:
            raise ValueError(f"Snakemake --config cannot override frozen {name}")
elif MODE == ExecMode.SUBPROCESS:
    expected_campaign_path = required_config("campaign_path")
    expected_execution_profile_path = required_config("execution_profile_path")
else:
    raise ValueError("unsupported Snakemake execution mode for frozen launch")

CAMPAIGN_PATH, EXECUTION_PROFILE_PATH = deployable_source_paths(
    expected_campaign_path,
    expected_execution_profile_path,
    working_directory=os.getcwd(),
)
if (
    expected_campaign_path != CAMPAIGN_PATH
    or expected_execution_profile_path != EXECUTION_PROFILE_PATH
):
    if MODE == ExecMode.DEFAULT:
        raise ValueError(
            "S3_STUDY_RUN_DIR and its parent directories must not be symlinks"
        )
    else:
        raise ValueError(
            "nested Snakemake config paths must use canonical "
            ".snakemake/runs/<single-name>/ filenames"
        )
RUN_DIR = Path(CAMPAIGN_PATH).parent.as_posix()
# Nested Snakemake receives paths relative to the deployed archive root rather
# than absolute paths from the submitting host.
config["campaign_path"] = CAMPAIGN_PATH
config["execution_profile_path"] = EXECUTION_PROFILE_PATH
EXPECTED_CAMPAIGN_SHA256 = required_config("campaign_sha256")
EXPECTED_EXECUTION_SHA256 = required_config("execution_sha256")
CAMPAIGN_SHA256 = require_sha256(
    CAMPAIGN_PATH, EXPECTED_CAMPAIGN_SHA256, label="campaign"
)
EXECUTION_SHA256 = require_sha256(
    EXECUTION_PROFILE_PATH, EXPECTED_EXECUTION_SHA256, label="execution profile"
)

# Config files are part of Snakemake's deployed workflow source archive. The
# rule inputs below are also explicitly local under a default remote provider.
configfile: CAMPAIGN_PATH
configfile: EXECUTION_PROFILE_PATH

CAMPAIGN = load_campaign(CAMPAIGN_PATH)
EXECUTION = load_execution_profile(EXECUTION_PROFILE_PATH)
RUNTIME_IMAGE = executor_runtime_image(EXECUTION)
if workflow.resource_settings.overwrite_resources:
    raise ValueError("--set-resources cannot override a frozen Snakemake launch")
if workflow.resource_settings.overwrite_threads:
    raise ValueError("--set-threads cannot override a frozen Snakemake launch")
ATTEMPTS = {
    (row["bucket"], row["tool"], row["case_id"], str(row["run_ordinal"])): row
    for row in CAMPAIGN["attempts"]
}
MARKERS = [
    marker_path(
        campaign=CAMPAIGN["campaign"],
        campaign_sha256=CAMPAIGN_SHA256,
        execution_sha256=EXECUTION_SHA256,
        attempt=row,
    )
    for row in CAMPAIGN["attempts"]
]
MARKER_PATTERN = (
    f"{MARKER_ROOT}/{CAMPAIGN['campaign']}/{CAMPAIGN_SHA256}/{EXECUTION_SHA256}"
    "/{bucket}/{tool}/{case_id}/run-{run_ordinal}.json"
)


def validate_exact_target():
    mode = MODE
    targets = tuple(workflow.dag_settings.targets)
    target_jobs = tuple(workflow.dag_settings.target_jobs)
    if mode == ExecMode.DEFAULT:
        if target_jobs or len(targets) != 1 or targets[0] not in MARKERS:
            raise ValueError(
                "outer Snakemake invocation requires exactly one frozen campaign marker target"
            )
        return
    if mode == ExecMode.SUBPROCESS:
        if targets or len(target_jobs) != 1:
            raise ValueError("nested Snakemake requires exactly one attempt target job")
        target = target_jobs[0]
        expected_keys = ("bucket", "tool", "case_id", "run_ordinal")
        wildcards = target.wildcards_dict
        if target.rulename != "attempt" or set(wildcards) != set(expected_keys):
            raise ValueError("nested Snakemake target job is not one frozen attempt")
        coordinate = tuple(str(wildcards[key]) for key in expected_keys)
        if coordinate not in ATTEMPTS:
            raise ValueError("nested Snakemake target job is not one frozen attempt")
        return
    raise ValueError("unsupported Snakemake execution mode for frozen launch")


def validate_executor_and_campaign_input():
    validate_exact_target()
    mode = MODE
    plugin = workflow.executor_plugin
    executor_name = None if plugin is None else plugin.name
    if mode == ExecMode.DEFAULT:
        if workflow.output_settings.dryrun:
            if executor_name != "dryrun":
                raise ValueError("normal --dry-run must use Snakemake's dryrun executor")
        elif executor_name != "googlebatch-study":
            raise ValueError("frozen launch requires the googlebatch-study executor")
    elif mode == ExecMode.SUBPROCESS:
        if executor_name != "local":
            raise ValueError("nested attempt execution requires Snakemake's local executor")
    else:
        raise ValueError("unsupported Snakemake execution mode for frozen launch")
    return CAMPAIGN_PATH


def selected(wildcards):
    return attempt_for_wildcards(ATTEMPTS, wildcards)


def projection(wildcards):
    return project_attempt(CAMPAIGN, selected(wildcards), EXECUTION)


rule all:
    input:
        MARKERS,


rule attempt:
    input:
        campaign=local(lambda wildcards: validate_executor_and_campaign_input()),
        execution_profile=local(EXECUTION_PROFILE_PATH),
    output:
        marker=MARKER_PATTERN,
    wildcard_constraints:
        run_ordinal=r"\d+",
    threads: lambda wildcards: projection(wildcards)["vcpus"]
    resources:
        googlebatch_machine_type=lambda wildcards: projection(wildcards)["machine_type"],
        googlebatch_cpu_milli=lambda wildcards: projection(wildcards)["cpu_milli"],
        googlebatch_memory=lambda wildcards: projection(wildcards)["memory_mib"],
        googlebatch_boot_disk_type=lambda wildcards: projection(wildcards)["boot_disk"]["type"],
        googlebatch_boot_disk_image=lambda wildcards: projection(wildcards)["boot_disk"]["image"],
        googlebatch_retry_count=lambda wildcards: projection(wildcards)["retry_count"],
        googlebatch_max_run_duration=lambda wildcards: projection(wildcards)["max_run_duration"],
        googlebatch_container=lambda wildcards: projection(wildcards)["image_uri"],
        googlebatch_runtime_image=RUNTIME_IMAGE,
        googlebatch_container_options=lambda wildcards: projection(wildcards)["container_options"] or "__unset__",
        googlebatch_service_account=lambda wildcards: projection(wildcards)["service_account"],
        googlebatch_secret_resource=lambda wildcards: projection(wildcards)["secret_resource"] or "__unset__",
        googlebatch_planned_job_id=lambda wildcards: projection(wildcards)["job_id"],
        googlebatch_provisioning=lambda wildcards: projection(wildcards)["provisioning"],
        googlebatch_zone=lambda wildcards: projection(wildcards)["zone"] or "__unset__",
        googlebatch_network=lambda wildcards: projection(wildcards)["network"] or "__unset__",
        googlebatch_subnetwork=lambda wildcards: projection(wildcards)["subnetwork"] or "__unset__",
    params:
        worker_argv=lambda wildcards: projection(wildcards)["worker_argv"],
        output_path=lambda wildcards: projection(wildcards)["output_path"],
        destination=lambda wildcards: projection(wildcards)["destination"],
        campaign_id=CAMPAIGN["campaign"],
        job_id=lambda wildcards: selected(wildcards)["job_id"],
        case_id=lambda wildcards: selected(wildcards)["case_id"],
        case_fingerprint=lambda wildcards: selected(wildcards)["case_fingerprint"],
        attempt_fingerprint=lambda wildcards: selected(wildcards)["attempt_fingerprint"],
        run_ordinal=lambda wildcards: selected(wildcards)["run_ordinal"],
        submission_number=lambda wildcards: selected(wildcards)["submission"],
        campaign_sha256=CAMPAIGN_SHA256,
        execution_sha256=EXECUTION_SHA256,
        frozen_provider_projection=lambda wildcards: canonical_provider_projection(
            CAMPAIGN, selected(wildcards), EXECUTION
        ),
    script:
        "scripts/run_attempt.py"
